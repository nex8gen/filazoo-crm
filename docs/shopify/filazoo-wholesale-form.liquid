{{ 'section-filazoo-wholesale.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --wsl-side-padding: {{ section.settings.side_padding }}px;
    --wsl-padding-top: {{ section.settings.padding_top }}px;
    --wsl-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- liquid
  assign anchor = section.settings.anchor_id | default: 'wholesale-application' | handleize
  assign business_types = section.settings.business_types | newline_to_br | split: '<br />'
  assign volume_options = section.settings.volume_options | newline_to_br | split: '<br />'
  assign material_options = section.settings.material_options | newline_to_br | split: '<br />'
  assign promises = section.settings.promises | newline_to_br | split: '<br />'
-%}

<section class="filazoo-wsl filazoo-wsl-form" id="{{ anchor }}">
  <div class="filazoo-wsl__inner">
    <div class="filazoo-wsl-form__layout">
      <aside class="filazoo-wsl-form__aside">
        <div class="filazoo-wsl__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="filazoo-wsl__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="filazoo-wsl__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="filazoo-wsl__subheading rte">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>

        {%- if promises.size > 0 -%}
          <ul class="filazoo-wsl-form__promises" role="list">
            {%- for promise in promises -%}
              {%- assign promise_text = promise | strip_newlines | strip -%}
              {%- if promise_text != blank -%}
                <li>{{ promise_text | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.contact_text != blank -%}
          <div class="filazoo-wsl-form__contact rte">{{ section.settings.contact_text }}</div>
        {%- endif -%}

        {%- if section.settings.email_button_label != blank and section.settings.email_address != blank -%}
          <a
            class="filazoo-wsl__btn filazoo-wsl__btn--ghost filazoo-wsl-form__email"
            href="mailto:{{ section.settings.email_address | strip }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
              <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{- section.settings.email_button_label | escape -}}
          </a>
        {%- endif -%}
      </aside>

      <div class="filazoo-wsl-form__panel">
        {%- form 'contact', id: 'WholesaleApplication', class: 'filazoo-wsl-form__form' -%}
          <input type="hidden" name="crm_form_id" value="filazoo-b2b-2026">
          <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
            <label for="WholesaleCompanyWebsiteConfirm">Leave this field empty</label>
            <input id="WholesaleCompanyWebsiteConfirm" type="text" name="company_website_confirm" tabindex="-1" autocomplete="off">
          </div>
          {%- if form.posted_successfully? -%}
            <div class="filazoo-wsl-form__status" role="status" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              <div>
                <p class="filazoo-wsl-form__status-title">{{ section.settings.success_title | escape }}</p>
                <p>{{ section.settings.success_text | escape }}</p>
              </div>
            </div>
          {%- elsif form.errors -%}
            <div class="filazoo-wsl-form__status filazoo-wsl-form__status--error" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              <div>
                <p class="filazoo-wsl-form__status-title">We could not send your enquiry.</p>
                <ul class="filazoo-wsl-form__status-list">
                  {%- for field in form.errors -%}
                    <li>
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}

          {%- comment -%}
            The short form. Four required fields is everything we need to price a
            lead: who they are, how to reach them, the business, and the volume.
            Anything else that used to be asked up front now lives in the optional
            block below, so a first-time visitor sees a form they can finish.
          {%- endcomment -%}
          <div class="filazoo-wsl-form__grid">
            <div class="filazoo-wsl-field">
              <label class="filazoo-wsl-field__label" for="WholesaleName">
                Your name <span class="required" aria-hidden="true">*</span>
              </label>
              <input id="WholesaleName" type="text" name="contact[Name]" autocomplete="name" required>
            </div>

            <div class="filazoo-wsl-field">
              <label class="filazoo-wsl-field__label" for="WholesaleEmail">
                Email <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                id="WholesaleEmail"
                type="email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{{ form.email }}"
                required
              >
            </div>

            <div class="filazoo-wsl-field">
              <label class="filazoo-wsl-field__label" for="WholesaleCompany">
                Business name <span class="required" aria-hidden="true">*</span>
              </label>
              <input id="WholesaleCompany" type="text" name="contact[Company]" autocomplete="organization" required>
            </div>

            <div class="filazoo-wsl-field">
              <label class="filazoo-wsl-field__label" for="WholesaleVolume">
                How much per month <span class="required" aria-hidden="true">*</span>
              </label>
              <select id="WholesaleVolume" name="contact[Estimated monthly volume]" required>
                <option value="">Select one…</option>
                {%- for option in volume_options -%}
                  {%- assign option_text = option | strip_newlines | strip -%}
                  {%- if option_text != blank -%}
                    <option value="{{ option_text | escape }}">{{ option_text | escape }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
              <span class="filazoo-wsl-field__hint">An estimate is fine. Pick “Not sure yet” if you would rather talk it through.</span>
            </div>

            <div class="filazoo-wsl-field filazoo-wsl-field--full">
              <label class="filazoo-wsl-field__label" for="WholesaleMessage">
                Anything we should know <span class="filazoo-wsl-field__optional">optional</span>
              </label>
              <textarea
                id="WholesaleMessage"
                name="contact[body]"
                rows="3"
                placeholder="Materials and colours you need, delivery schedule, deadlines — or leave this empty and we will ask."
              >{{ form.body }}</textarea>
            </div>
          </div>

          {%- if section.settings.show_optional_details -%}
            {%- comment -%}
              Closed by default, and nothing inside it is `required`: a required
              field in a collapsed <details> cannot be focused, so the browser
              blocks submission with an error nobody can see.
            {%- endcomment -%}
            <details class="filazoo-wsl-form__more">
              <summary class="filazoo-wsl-form__more-toggle">
                {{ section.settings.optional_label | escape }}
              </summary>

              <div class="filazoo-wsl-form__grid">
                <div class="filazoo-wsl-field">
                  <label class="filazoo-wsl-field__label" for="WholesalePhone">Phone</label>
                  <input id="WholesalePhone" type="tel" name="contact[Phone]" autocomplete="tel">
                </div>

                <div class="filazoo-wsl-field">
                  <label class="filazoo-wsl-field__label" for="WholesaleType">Business type</label>
                  <select id="WholesaleType" name="contact[Business type]">
                    <option value="">Select one…</option>
                    {%- for type in business_types -%}
                      {%- assign type_text = type | strip_newlines | strip -%}
                      {%- if type_text != blank -%}
                        <option value="{{ type_text | escape }}">{{ type_text | escape }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>

                <div class="filazoo-wsl-field">
                  <label class="filazoo-wsl-field__label" for="WholesaleCountry">Country</label>
                  <input id="WholesaleCountry" type="text" name="contact[Country]" autocomplete="country-name">
                </div>

                <div class="filazoo-wsl-field">
                  <label class="filazoo-wsl-field__label" for="WholesaleRegion">State / region / city</label>
                  <input id="WholesaleRegion" type="text" name="contact[Region]" autocomplete="address-level1">
                </div>

                <div class="filazoo-wsl-field">
                  <label class="filazoo-wsl-field__label" for="WholesaleWebsite">Website or storefront</label>
                  <input id="WholesaleWebsite" type="url" name="contact[Website]" placeholder="https://" autocomplete="url">
                </div>

                <div class="filazoo-wsl-field">
                  <label class="filazoo-wsl-field__label" for="WholesaleTaxId">Tax, VAT or resale ID</label>
                  <input id="WholesaleTaxId" type="text" name="contact[Tax or resale ID]">
                  <span class="filazoo-wsl-field__hint">Speeds up approval.</span>
                </div>

                <div class="filazoo-wsl-field">
                  <label class="filazoo-wsl-field__label" for="WholesaleRole">Job title</label>
                  <input id="WholesaleRole" type="text" name="contact[Job title]" autocomplete="organization-title">
                </div>

                <div class="filazoo-wsl-field">
                  <label class="filazoo-wsl-field__label" for="WholesalePrinters">Printers in operation</label>
                  <input id="WholesalePrinters" type="text" name="contact[Printers in operation]" placeholder="e.g. 24 × Bambu P1S">
                </div>

                {%- if material_options.size > 0 -%}
                  <div class="filazoo-wsl-field filazoo-wsl-field--full">
                    <span class="filazoo-wsl-field__label" id="WholesaleMaterialsLabel">Materials you are interested in</span>
                    <div class="filazoo-wsl-checks" role="group" aria-labelledby="WholesaleMaterialsLabel">
                      {%- for material in material_options -%}
                        {%- assign material_text = material | strip_newlines | strip -%}
                        {%- if material_text != blank -%}
                          <label class="filazoo-wsl-check">
                            <input type="checkbox" name="contact[Material — {{ material_text | escape }}]" value="Yes">
                            <span>{{ material_text | escape }}</span>
                          </label>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}

                <div class="filazoo-wsl-field filazoo-wsl-field--full">
                  <span class="filazoo-wsl-field__label" id="WholesaleExtrasLabel">Anything else we should set up</span>
                  <div class="filazoo-wsl-checks" role="group" aria-labelledby="WholesaleExtrasLabel">
                    <label class="filazoo-wsl-check">
                      <input type="checkbox" name="contact[Wants a sample kit]" value="Yes">
                      <span>Send a sample kit first</span>
                    </label>
                    <label class="filazoo-wsl-check">
                      <input type="checkbox" name="contact[Wants private label]" value="Yes">
                      <span>Private label / custom colours</span>
                    </label>
                    <label class="filazoo-wsl-check">
                      <input type="checkbox" name="contact[Wants dropshipping]" value="Yes">
                      <span>Dropshipping to my customers</span>
                    </label>
                    <label class="filazoo-wsl-check">
                      <input type="checkbox" name="contact[Wants net terms]" value="Yes">
                      <span>Net payment terms</span>
                    </label>
                  </div>
                </div>
              </div>
            </details>
          {%- endif -%}

          {%- if section.settings.consent_text != blank -%}
            {%- if section.settings.consent_style == 'checkbox' -%}
              <label class="filazoo-wsl-consent">
                <input type="checkbox" name="contact[Consent]" value="Yes" required>
                <span>{{ section.settings.consent_text }}</span>
              </label>
            {%- else -%}
              {%- comment -%}
                Same disclosure, one fewer thing to click: submitting the form is
                the consent, and the wording says so.
              {%- endcomment -%}
              <div class="filazoo-wsl-form__consent-note rte">{{ section.settings.consent_text }}</div>
            {%- endif -%}
          {%- endif -%}

          <div class="filazoo-wsl-form__submit">
            <button type="submit" class="filazoo-wsl__btn">
              {{ section.settings.submit_label | escape }}
            </button>
            {%- if section.settings.submit_note != blank -%}
              <p class="filazoo-wsl-form__submit-note">{{ section.settings.submit_note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% javascript %}
(() => {
  const endpoint = 'https://crm.filazoosupply.com/api/shopify/form-lead';
  const bindCrmMirror = () => {
    const form = document.getElementById('WholesaleApplication');
    if (!form || form.dataset.crmMirrorBound === 'true') return;
    form.dataset.crmMirrorBound = 'true';
    form.addEventListener('submit', () => {
      if (!form.checkValidity()) return;
      const data = new FormData(form);
      if (String(data.get('company_website_confirm') || '').trim()) return;
      const submissionId = window.crypto?.randomUUID?.() || String(Date.now()) + '-' + Math.random().toString(36).slice(2);
      data.set('submission_id', submissionId);
      let queued = false;
      try {
        queued = typeof navigator.sendBeacon === 'function' && navigator.sendBeacon(endpoint, data);
      } catch {}
      if (!queued) {
        void fetch(endpoint, { method: 'POST', body: data, keepalive: true, mode: 'cors' }).catch(() => {});
      }
    });
  };
  bindCrmMirror();
  document.addEventListener('shopify:section:load', bindCrmMirror);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Wholesale application",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Buttons elsewhere on the page jump here. Keep it as wholesale-application unless you change those links too.",
      "default": "wholesale-application"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get the price"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get your price list"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Four fields and you are done. A person reads every enquiry and replies with your tier, price list and lead times — usually within one business day.</p>"
    },
    {
      "type": "textarea",
      "id": "promises",
      "label": "Reassurance list",
      "info": "One line per item.",
      "default": "Four fields, about a minute\nA person replies within one business day\nNo fee, no exclusivity\nSample kit before your first bulk order"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Direct contact",
      "default": "<p>Would you rather talk first? Email <a href=\"mailto:raul@filazoo.com\">raul@filazoo.com</a> with the volume and materials you have in mind.</p>"
    },
    {
      "type": "text",
      "id": "email_button_label",
      "label": "Email button label",
      "default": "Email us",
      "info": "Leave blank to hide the button. On phones the button replaces the direct contact text above."
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email button address",
      "default": "raul@filazoo.com"
    },
    {
      "type": "header",
      "content": "Optional details"
    },
    {
      "type": "checkbox",
      "id": "show_optional_details",
      "label": "Show the optional details section",
      "info": "A collapsed block under the short form holding phone, business type, location, website, tax ID, job title, printers and the material checkboxes. Turn it off for the four-field form on its own.",
      "default": true
    },
    {
      "type": "text",
      "id": "optional_label",
      "label": "Optional details label",
      "default": "Add more details (optional)"
    },
    {
      "type": "header",
      "content": "Dropdown options"
    },
    {
      "type": "textarea",
      "id": "business_types",
      "label": "Business type options",
      "info": "One line per option.",
      "default": "Print farm / production bureau\nRetailer or online reseller\nDistributor\nSchool, university or makerspace\nManufacturer or engineering team\nPrinter manufacturer / OEM\nOther"
    },
    {
      "type": "textarea",
      "id": "volume_options",
      "label": "Monthly volume options",
      "info": "One line per option.",
      "default": "Under 50 kg\n50–199 kg\n200–499 kg\n500–999 kg\n1,000 kg or more\nNot sure yet"
    },
    {
      "type": "textarea",
      "id": "material_options",
      "label": "Material checkboxes",
      "info": "One line per material.",
      "default": "PLA & PLA+\nMatte PLA\nSilk PLA\nPETG\nTPU\nABS / ASA\nCarbon fibre blends\nPPA-CF / PEEK-CF\nAccessories"
    },
    {
      "type": "header",
      "content": "Submit and confirmation"
    },
    {
      "type": "select",
      "id": "consent_style",
      "label": "Consent",
      "info": "A note is one less thing to click. Use the tick box if your region needs an explicit opt-in.",
      "options": [
        { "value": "note", "label": "Note under the form" },
        { "value": "checkbox", "label": "Required tick box" }
      ],
      "default": "note"
    },
    {
      "type": "richtext",
      "id": "consent_text",
      "label": "Consent text",
      "default": "<p>By sending this you confirm you are enquiring on behalf of a business and agree to be contacted about wholesale pricing. We never share or resell your details.</p>"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Get my price list"
    },
    {
      "type": "text",
      "id": "submit_note",
      "label": "Note beside the button",
      "default": "We reply within one business day, and there is no obligation."
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success heading",
      "default": "Thanks, we have your details."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "We will reply with your tier, price list and lead times within one business day."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 15,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Side padding",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Wholesale application"
    }
  ]
}
{% endschema %}
