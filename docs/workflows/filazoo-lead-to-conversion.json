                    }
                  },
                  {
                    "id": "filazoo-meta-done",
                    "type": "stop",
                    "config": {
                      "reason": "Acquisition review handed to the account owner",
                      "outcome": "completed"
                    }
                  }
                ]
              },
              {
                "id": "filazoo-meta-advanced",
                "name": "Existing commercial conversation",
                "condition": null,
                "steps": [
                  {
                    "id": "filazoo-meta-preserve",
                    "type": "stop",
                    "config": {
                      "reason": "Preserve the existing commercial conversation",
                      "outcome": "completed"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Filazoo - review customer requirements and buying replies",
      "triggerType": "email_received",
      "triggerConfig": {
        "reentryMode": "every_event"
      },
      "status": "draft",
      "steps": [
        {
          "id": "filazoo-reply-review",
          "type": "create_task",
          "config": {
            "assigneeType": "owner",
            "assigneeId": null,
            "dueInDays": 0,
            "title": "Review customer reply and choose the commercial next step",
            "priority": "high",
            "notes": "Read the latest message and attachments. Identify requirements, sample feedback, changes, objections, postponement, explicit quote acceptance or a customer PO. Verify exact quotation ID/version, quantities, currency and terms before recording acceptance or confirming a PO. Do not infer acceptance from interest, opens or clicks. A draft PO is not confirmed. Update records through authorized actions."
          }
        },
        {
          "id": "filazoo-reply-alert",
          "type": "internal_alert",
          "config": {
            "userId": "owner",
            "message": "A customer replied. Review requirements, negotiations, explicit quote acceptance or a customer PO. No commercial decision was made automatically.",
            "includeThreadLink": true,
            "channel": "in_app"
          }
        },
        {
          "id": "filazoo-reply-done",
          "type": "stop",
          "config": {
            "reason": "Customer reply assigned for evidence-based review",
            "outcome": "completed"
          }
        }
      ]
    },
    {
      "name": "Filazoo - review a quotation awaiting feedback",
      "triggerType": "category_changed",
      "triggerConfig": {
        "category": "Quotation Follow-up",
        "reentryMode": "every_event"
      },
      "status": "draft",
      "steps": [
        {
          "id": "filazoo-quote-wait",
          "type": "wait",
          "config": {
            "amount": 2,
            "unit": "days",
            "businessDays": true
          }
        },
        {
          "id": "filazoo-quote-tag-check",
          "type": "if_condition",
          "config": {
            "field": "category_is",
            "category": "Quotation Follow-up",
            "action": "continue",
            "unmatchedAction": "stop_flow"
          }
        },
        {
          "id": "filazoo-quote-reply-check",
          "type": "if_condition",
          "config": {
            "field": "customer_replied",
            "action": "stop_flow",
            "unmatchedAction": "continue",
            "lookbackDays": 30
          }
        },
        {
          "id": "filazoo-quote-review",
          "type": "create_task",
          "config": {
            "assigneeType": "owner",
            "assigneeId": null,
            "dueInDays": 0,
            "title": "Check saved quotation and decide whether follow-up is needed",
            "priority": "high",
            "notes": "Open the current saved quotation and linked PO before contacting the buyer. Stop acquisition follow-up if the quote is accepted or a linked PO confirmed. If expired, declined, superseded, cancelled or postponed, use the matching review action. Otherwise offer a helpful next step. A conversation tag is not proof of quotation status. This workflow sends no customer reminder."
          }
        },
        {
          "id": "filazoo-quote-alert",
          "type": "internal_alert",
          "config": {
            "userId": "owner",
            "message": "A quotation conversation had no new reply during the review wait. Check the saved quotation and PO before following up.",
            "includeThreadLink": true,
            "channel": "in_app"
          }
        },
        {
          "id": "filazoo-quote-done",
          "type": "stop",
          "config": {
            "reason": "Quotation review assigned; no external reminder sent",
            "outcome": "completed"
          }
        }
      ]
    }
  ]
}
