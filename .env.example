# Public CRM origin used in emailed links. In production use the custom domain,
# never a Vercel preview/deployment URL protected by Vercel Authentication.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current Supabase key names. Legacy ANON/SERVICE_ROLE names remain supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Live CRM routes always require a verified session. Retained for legacy tooling.
AUTH_REQUIRED=true
# Optional dedicated QR signing secret (32+ random characters). Defaults to the
# server Supabase secret. Changing this value invalidates previously printed QR links.
CUSTOMER_PORTAL_SECRET=
# Typed model-independent CRM agent (default). Set legacy only for rollback.
AI_AGENT_RUNTIME=sdk
# Vercel deployments use request-scoped OIDC automatically.
# Local/worker access uses a Gateway key or `vercel env pull` OIDC token.
AI_GATEWAY_API_KEY=
# Tested task routing. Only the priced model allowlist can be selected.
AI_GATEWAY_EMAIL_MODEL=google/gemini-2.5-flash-lite
AI_GATEWAY_SIMPLE_MODEL=google/gemini-2.5-flash-lite
AI_GATEWAY_STANDARD_MODEL=anthropic/claude-haiku-5.5
AI_GATEWAY_COMPLEX_MODEL=google/gemini-3.5-flash-lite
# Workspace chat is read-only; agent mode adds actions and approval controls.
# Optional independent overrides. Blank values keep the existing working model.
AI_GATEWAY_CHAT_MODEL=anthropic/claude-haiku-5.5
AI_GATEWAY_AGENT_MODEL=anthropic/claude-haiku-5.5
AI_GATEWAY_VISION_MODEL=anthropic/claude-haiku-5.5
# Translation defaults to Google's unofficial free endpoint (no key; may throttle).
# Optional: use your own LibreTranslate server without a provider daily quota.
# Base URL only, e.g. http://localhost:5000 (do not append /translate).
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Facebook Page Messenger and Lead Ads. Keep all values server-side.
META_FACEBOOK_PAGE_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_WEBHOOK_SECRET=
META_VERIFY_TOKEN=
META_LEAD_BRIDGE_SECRET=
META_GRAPH_API_VERSION=v26.0
# Shopify B2B form leads. Configure the Shopify Forms app to add the tag below.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_B2B_FORM_TAG=b2b-lead
SHOPIFY_FORM_ORIGIN=https://filazoo.com
SHOPIFY_B2B_FORM_ID=filazoo-b2b-2026
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
OUTREACH_FROM_EMAIL=
BUSINESS_NAME=Filazoo
BUSINESS_ADDRESS=
DAILY_SEND_LIMIT=20
BOUNCE_PAUSE_PERCENT=3
# Vercel Cron uses this bearer secret to invoke the automation worker.
CRON_SECRET=
# Legacy fallback only: prefer Settings -> ERP connection for credentials,
# warehouse selection, SKU mappings and automatic updates without code edits.
# Enable inventoryDetails API access and allowlist the server IP in Lingxing.
LINGXING_APP_ID=
LINGXING_APP_SECRET=
# Blank includes all local/overseas warehouses. Amazon FBA is a separate API.
LINGXING_WAREHOUSE_IDS=
# Optional exact CRM SKU -> ERP SKU aliases, including color/size variants.
LINGXING_SKU_MAP={}
# Optional AI history estimates: model-specific USD per million input/output
# tokens. Empty means unknown prices; reported token counts are still saved.
# Shape: {"your-model-id":{"input":0.1,"output":0.4}} (use current provider rates).
AI_CHAT_MODEL_RATES_JSON={}

# Twilio: server-only credentials and the exact public URL configured in Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_FACEBOOK_FROM=
TWILIO_WEBHOOK_URL=
