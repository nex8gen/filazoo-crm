# Public CRM origin used in emailed links. In production use the custom domain,
# never a Vercel preview/deployment URL protected by Vercel Authentication.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current Supabase key names. Legacy ANON/SERVICE_ROLE names remain supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REQUIRED=false
GEMINI_API_KEY=
# Optional model override for AI-assisted professional email rewriting.
GEMINI_EMAIL_MODEL=gemini-3.5-flash-lite
AI_GATEWAY_API_KEY=
AI_GATEWAY_EMAIL_MODEL=alibaba/qwen-3-14b
# Optional: identifies this app to the free translation service for a higher daily quota.
MYMEMORY_CONTACT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Facebook Page Messenger and Lead Ads. Keep all values server-side.
META_FACEBOOK_PAGE_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_WEBHOOK_SECRET=
META_VERIFY_TOKEN=
META_LEAD_BRIDGE_SECRET=
META_GRAPH_API_VERSION=v26.0
# Shopify B2B form leads. Configure the Shopify Forms app to add the tag below.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_B2B_FORM_TAG=b2b-lead
SHOPIFY_FORM_ORIGIN=https://filazoo.com
SHOPIFY_B2B_FORM_ID=filazoo-b2b-2026
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
OUTREACH_FROM_EMAIL=
BUSINESS_NAME=Filazoo
BUSINESS_ADDRESS=
DAILY_SEND_LIMIT=20
BOUNCE_PAUSE_PERCENT=3
# Vercel Cron uses this bearer secret to invoke the automation worker.
CRON_SECRET=
