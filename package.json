{
  "name": "filazoo-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-local-dependencies.mjs && node scripts/check-local-env.mjs",
    "dev": "next dev",
    "crm": "node scripts/start-crm.mjs",
    "crm:start": "node scripts/start-crm.mjs --skip-build",
    "crm:update": "node scripts/update-crm.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test --test-concurrency=2 tests/*.test.ts",
    "ai:eval:plan": "node --experimental-strip-types scripts/run-agent-soak.ts",
    "ai:eval:24h": "node --env-file=.env.local --experimental-strip-types scripts/run-agent-soak.ts --live",
    "ai:eval:status": "node scripts/agent-soak-status.mjs",
    "perf:bundles": "node scripts/audit-client-bundles.mjs",
    "mail:worker": "node --env-file=.env.local --experimental-strip-types scripts/mail-sync-worker.ts",
    "verify": "npm run lint && npm run test && npm run build && npm run perf:bundles"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.112",
    "@ai-sdk/openai": "4.0.109",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paper-design/shaders-react": "0.0.82",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-table": "^9.2.8",
    "@types/imap": "^0.8.43",
    "@vercel/analytics": "2.0.1",
    "@vercel/oidc": "3.2.0",
    "@vercel/postgres": "^0.10.0",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.163",
    "border-beam": "1.4.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "country-state-city": "3.2.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "htmlparser2": "10.1.0",
    "imap": "^0.8.19",
    "imapflow": "2.10.0",
    "libmime": "5.4.7",
    "lucide-react": "^1.54.0",
    "mailparser": "^3.9.38",
    "motion": "^14.6.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "orb-ui": "^0.10.0",
    "pdfjs-dist": "6.5.438",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tldts": "7.4.22",
    "tw-animate-css": "^1.4.0",
    "twilio": "6.2.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
